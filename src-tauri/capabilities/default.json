{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "log:default",
    "allow-greet",
    "allow-open-log-dir",
    "allow-list-connections",
    "allow-create-connection",
    "allow-update-connection",
    "allow-delete-connection",
    "allow-get-connection",
    "allow-connect-broker",
    "allow-disconnect-broker",
    "allow-test-connection",
    "allow-publish-message",
    "allow-subscribe-topic",
    "allow-unsubscribe-topic",
    "allow-list-favorites",
    "allow-create-favorite",
    "allow-get-favorite",
    "allow-update-favorite",
    "allow-delete-favorite"
  ]
}
