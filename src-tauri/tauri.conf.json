{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bme",
  "version": "0.8.0",
  "identifier": "com.christoph.bme",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/bme/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Better MQTT Explorer",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "christoph-create",
    "homepage": "https://github.com/christoph-create/bme",
    "copyright": "Copyright © 2026 christoph-create",
    "license": "GPL-3.0-or-later",
    "category": "DeveloperTool",
    "shortDescription": "Better MQTT Explorer",
    "longDescription": "A fast, native desktop client for developing against MQTT brokers. Keep several broker connections on hand, watch messages arrive on a live topic tree, dig into a topic's history, and publish test messages from saved templates.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
